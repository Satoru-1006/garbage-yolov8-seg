  "decisions": {
    "D1": {
      "question": "是否正式批准 other 为兜底类？",
      "verdict": "APPROVED_WITH_PER_CLASS_REVIEW",
      "effect": "OTHER_CANDIDATE 层 27 类 / 1198 实例经逐类审核后全部写入 other(5)",
      "rationale": "27 类均为无专用类的杂项垃圾(容器配件/碎玻璃/餐具/绳线/泡沫等)；其余未被批准的杂项仍留在 DEFER，不由 other 兜底。"
    },
    "D2": {
      "question": "Plastic film(36, 451 实例/310 图) 归 plastic_bag 还是 wrapper？",
      "verdict": "NOT_FORCED_DEFERRED",
      "effect": "保持未映射；含 Plastic film 的图像整图排除",
      "rationale": "薄膜与袋/包装的边界主观，是 TACO 最大类之一，单次决定影响过大；按任务要求暂不强制映射。"
    },
    "D3": {
      "question": "Carton 系列是否等同 box？",
      "verdict": "PARTIAL_CONFIRMED",
      "effect": "盒形纸板(Other carton/Egg carton/Corrugated carton/Meal carton/Pizza box) -> box；Drink carton(利乐包)、Toilet tube(纸筒) 保持 DEFER",
      "rationale": "box 语义严格对齐室内：典型的纸板盒归 box；液体饮料纸盒与纸筒形态/定义存在争议，交由人工裁决。"
    },
    "D4": {
      "question": "Glass bottle(6) 是否并入 bottle？",
      "verdict": "DEFERRED",
      "effect": "保持未映射；含 Glass bottle 的图像整图排除",
      "rationale": "bottle 需严格对齐室内语义；玻璃材质与被审为塑料瓶的 bottle 存在材质冲突，不擅自并入。"
    },
    "D5": {
      "question": "paper 是否含杯/袋/吸管形态(20/32/34/56)？",
      "verdict": "DEFERRED",
      "effect": "Paper cup / Paper bag / Paper straw / Wrapping paper 保持未映射；含其图像整图排除",
      "rationale": "paper 严格对齐室内(片状纸制品)；杯/袋/吸管为立体容器形态，Wrapping paper 与 wrapper 命名冲突，均待人工裁决。"
    },
    "D6": {
      "question": "Unlabeled litter(58) 所在 269 张图如何处理？",
      "verdict": "WHOLE_IMAGE_EXCLUDE",
      "effect": "269 张整图排除（517 实例不写入）",
      "rationale": "该类表示已定位但未定类的垃圾；映射为背景=真实垃圾变负样本，映射为 other=语义噪声，故整图排除。"
    },
    "D7": {
      "question": "多部件多边形(114 条标注 / 81 图)合并策略？",
      "verdict": "ISOLATED_EXCLUDED_V1",
      "effect": "含多部件 Polygon 的 81 张图在第一版整图隔离排除；转换器内置 largest/split/union-contour 策略以便后续裁决",
      "rationale": "一行一实例的 YOLO-Seg 格式无法无损表达一实例多部件；三种策略各有缺陷，第一版不预设，交由人工裁决。"
    }
  },
