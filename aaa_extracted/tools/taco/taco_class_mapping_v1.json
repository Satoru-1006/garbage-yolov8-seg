    "principles": [
      "只启用可确证语义的类别；PROVISIONAL 层整体 DEFER（不映射、不由 other 兜底），其所在图像整图排除，避免未映射实例静默变成背景负样本。",
      "other 正式批准为杂项兜底类，但对 OTHER_CANDIDATE 层 27 类逐类人工审核后才写入（见 other_tier_review）。",
      "box / bottle / paper 严格与室内 9 类语义一致：纸盒类(Carton 的盒形)归 box；玻璃瓶(材质不符)与纸杯/纸袋/纸吸管/包装纸(形态不符)不并入 bottle / paper。",
      "目标类别编号与 datasets/garbage_seg_merged_full1444 完全一致，不得改动。",
      "禁止用矩形框冒充分割轮廓；只写 COCO polygon。"
    ],
    "actions": {
      "MAP": "写入目标类标签",
      "DEFER": "语义待人工裁决，保持未映射 -> 含该类实例的图像整图排除",
      "EXCLUDE_STRUCTURAL": "结构性禁用(Unlabeled litter) -> 含该类实例的图像整图排除",
      "EXCLUDE_UNRESOLVED": "无可靠对应 -> 含该类实例的图像整图排除",
      "EMPTY": "零实例，无影响"
    }
  },
